# Default playback and capture device for the I2S3 MAX98357 / microphone.
# Install as /etc/asound.conf so pygame does not send audio to HDMI and
# i2s-keepalive.service (running as root) can share the same dmix.
#
# Playback goes through dmix so i2s-keepalive.service can stream silence
# while pygame plays sounds. The MAX98357 pops whenever the I2S clock
# starts or stops.
pcm.dmixer {
    type dmix
    ipc_key 1024
    ipc_key_add_uid false
    ipc_perm 0666
    slave {
        pcm "hw:dummysound,0"
        format S16_LE
        rate 48000
        channels 2
        period_size 1024
        buffer_size 4096
    }
}

pcm.!default {
    type asym
    playback.pcm {
        type plug
        slave.pcm "dmixer"
    }
    capture.pcm {
        type plug
        slave.pcm "hw:dummysound,0"
    }
}

ctl.!default {
    type hw
    card dummysound
}
